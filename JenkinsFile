pipeline {
    agent any

    environment {
        registry            = "skotte2/student-survey-form"
        registryCredential  = 'Docker'
        dateTag             = "${new Date().format('yyyyMMdd-HHmmss')}"
    }

    stages {
        stage('Install & Test') {
            steps {
                sh '''
                  python3 -m venv .venv
                  . .venv/bin/activate
                  pip install --upgrade pip
                  pip install -r app/requirements.txt
                  if [ -d "tests" ]; then
                    pytest -q
                  fi
                '''
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    docker.withRegistry('', registryCredential) {
                        def customImage = docker.build("${registry}:${dateTag}")
                    }
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                script {
                    docker.withRegistry('', registryCredential) {
                        def image = docker.build("${registry}:${dateTag}", '.')
                        image.push()
                        image.push('latest')
                    }
                }
            }
        }

        stage('Deploy to Rancher') {
            steps {
                script {
                    sh "kubectl set image deployment/swe645-extracredit-deployment container-0=${registry}:${dateTag}"
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout'
        }
    }
}
